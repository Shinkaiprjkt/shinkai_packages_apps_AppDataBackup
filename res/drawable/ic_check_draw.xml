<!-- Stroke-only checkmark. trimPathEnd starts at 0 (invisible) so
     avd_check_draw.xml can animate it to 1 ("draw itself" reveal). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp" android:height="120dp"
    android:viewportWidth="120" android:viewportHeight="120">
    <path
        android:name="check_path"
        android:pathData="M 38,62 L 54,78 L 86,40"
        android:strokeColor="@android:color/white"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:trimPathStart="0"
        android:trimPathEnd="0"
        android:trimPathOffset="0" />
</vector>
